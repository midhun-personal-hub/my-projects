# =========================
# Server secrets
# =========================
GEMINI_API_KEY="YOUR_GEMINI_API_KEY"
GEMINI_MODEL="gemini-3.8-flash"
GEMINI_FALLBACK_MODELS="gemini-3.5-flash,gemini-3.5-flash-lite"
AI_REQUESTS_PER_HOUR="40"
PORT="3000"

# =========================
# Firebase server authentication
# =========================
FIREBASE_PROJECT_ID="YOUR_PROJECT_ID"

# For Vercel/non-Google hosts, use ONE of these approaches.
# Recommended for a single Vercel secret:
FIREBASE_SERVICE_ACCOUNT_JSON="{\"type\":\"service_account\",\"project_id\":\"YOUR_PROJECT_ID\",\"private_key_id\":\"...\",\"private_key\":\"-----BEGIN PRIVATE KEY-----\\n...\\n-----END PRIVATE KEY-----\\n\",\"client_email\":\"firebase-adminsdk-...@YOUR_PROJECT_ID.iam.gserviceaccount.com\"}"

# Or use separate variables instead of FIREBASE_SERVICE_ACCOUNT_JSON:
# FIREBASE_CLIENT_EMAIL="firebase-adminsdk-...@YOUR_PROJECT_ID.iam.gserviceaccount.com"
# FIREBASE_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\\n...\\n-----END PRIVATE KEY-----\\n"

# =========================
# Firebase client configuration (Vite exposes VITE_* values to the browser)
# =========================
VITE_FIREBASE_API_KEY="YOUR_FIREBASE_API_KEY"
VITE_FIREBASE_AUTH_DOMAIN="YOUR_PROJECT_ID.firebaseapp.com"
VITE_FIREBASE_PROJECT_ID="YOUR_PROJECT_ID"
VITE_FIREBASE_STORAGE_BUCKET="YOUR_PROJECT_ID.firebasestorage.app"
VITE_FIREBASE_MESSAGING_SENDER_ID="YOUR_MESSAGING_SENDER_ID"
VITE_FIREBASE_APP_ID="YOUR_FIREBASE_APP_ID"
# Optional custom Firestore database ID
# VITE_FIREBASE_FIRESTORE_DATABASE_ID="YOUR_FIRESTORE_DATABASE_ID"
